  for (Doc_Code_Sample *sample = code->first;
       sample != 0;
       sample = sample->next){
    insertf(insert, "language: ");
    switch (sample->language){
      case DocCodeLanguage_Cpp:
      {
        insertf(insert, "C++\n");
      }break;
      case DocCodeLanguage_Bat:
      {
        insertf(insert, "Batch\n\n");
