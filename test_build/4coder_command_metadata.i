    Scratch_Block scratch(app);

    Fancy_Block block = {};
    for (i32 i = 0; i < menu->count; i += 1){
      if (menu->options[i].size > 0){
        Fancy_Line *line = push_fancy_line(scratch, &block, face);
        push_fancy_stringf(scratch, line, fcolor_id(defcolor_pop1), "F%d:", i + 1);
