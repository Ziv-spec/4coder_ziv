    u8 *in = string.str;
    u8 *out = result.str;

    if (character_is_base10(*in)){
      *out = '_';
      out += 1;
      result.size += 1;
    }

    for (u64 i = 0; i < string.size; i += 1, in += 1, out += 1){
      u8 c = *in;
