        insertf(&out, "%d,%d: %S\n", cursor.line, cursor.col, line_str);
        end_temp(line_temp);
      }
    }
  }
  else{
    insertf(&out, "no matches");
  }

  end_buffer_insertion(&out);
  lock_jump_buffer(app, out_buffer_id);
}

