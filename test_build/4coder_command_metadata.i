static char* key_mod_name(Key_Code m){
  return (char*)(m == KeyCode_Control ? "Ctrl"  :
                 m == KeyCode_Command ? "Cmd"   :
                 m == KeyCode_Alt     ? "Alt"   :
                 m == KeyCode_Shift   ? "Shift" : ((key_code_name)[(m)%((sizeof(key_code_name))/(sizeof(*key_code_name)))]));
}

static u8 mod_bit_from_key(Key_Code c){
  return (c == KeyCode_Control ? bit_1 :
          c == KeyCode_Command ? bit_2 :
          c == KeyCode_Alt     ? bit_3 :
          c == KeyCode_Shift   ? bit_4 : 0);
}

static Key_Code mod_key_from_bit(u64 b){
  return (b == bit_1 ? KeyCode_Control :
          b == bit_2 ? KeyCode_Command :
          b == bit_3 ? KeyCode_Alt     :
          b == bit_4 ? KeyCode_Shift   : 0);
}

