  if (log_view != 0 && log_graph.holding_temp){
    Log_Graph_Box *box_node = log_graph__get_box_at_point(&log_graph, m_p);
    if (box_node != 0){
      log_graph.selected_event = box_node->event;
    }
    else{
      log_graph.has_unused_click = true;
      log_graph.unused_click = m_p;
