    x1 = range_union(x1, Ii64(max_pos));
    MC_insert(app, min_pos, max_pos);
  }
  
  view_set_cursor(app, view, seek_pos(cursor_pos < mark_pos ? x0.min : x0.max));
  MC_begin(app);
  view_set_mark(app, view, seek_pos(cursor_pos < mark_pos ? x1.min : x1.max));
}


