static Token_List
lex_full_input_lua(Arena *arena, String_Const_u8 input){
  Lex_State_Lua state = {};
  lex_full_input_lua_init(&state, input);
  Token_List list = {};
  lex_full_input_lua_breaks(arena, &list, &state, max_u64);
  return(list);
}

static Token_List
lex_full_input_async_lua(Async_Context *actx, Arena *arena, String_Const_u8 input, i32 limit, b32 *canceled){
  Lex_State_Lua state = {};
  Token_List list = {};
  lex_full_input_lua_init(&state, input);
  for (;;){
    if (lex_full_input_lua_breaks(arena, &list, &state, limit)){
      break;
    }
    if (async_check_canceled(actx)){
      *canceled = true;
      break;
    }
  }
  return(list);
}

static b32 qol_tok_accept(QOL_Parse_State *state, Token_Lua_Kind kind){
  Token *token = qol_tok_peek(state);
  if (token != 0 && token->sub_kind == kind){
    qol_tok_consume(state);
    return true;
  }
  return false;
}

static b32 qol_tok_peek(QOL_Parse_State *state, Token_Lua_Kind kind, Token **out_tok){
  if (state->generic.finished){ return false; }
  Token *token = qol_tok_peek(state);
  if (token->sub_kind == kind){
    *out_tok = token;
    return true;
  }
  return false;
}

static b32 qol_tok_peek(QOL_Parse_State *state, Token_Lua_Kind kind){
  Token *t;
  return qol_tok_peek(state, kind, &t);
