static void qol_post_command_inner(Application_Links *app, Managed_Scope scope){
  QOL_View_Jumps *jumps = ((QOL_View_Jumps*)managed_scope_get_attachment((app), (scope), (qol_view_jumps), sizeof(QOL_View_Jumps)));
  QOL_Point point = qol_current_point(app);
  if (jumps != 0 && jumps->check && qol_is_jump(app, jumps->point, point)){
    i64 cap = ((sizeof(jumps->ring))/(sizeof(*jumps->ring)));
    if (jumps->pos - jumps->bot == cap-1){
      qol_free_slot(app, jumps->ring[jumps->bot++ % cap]);
    }
    if (2*cap <= jumps->pos){
      jumps->top -= cap;
      jumps->bot -= cap;
    }
    jumps->ring[jumps->pos++ % cap] = qol_alloc_slot_from_point(app, jumps->point);
    jumps->top = jumps->pos;
  }
}

